rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{document} {
      function hasValidMedia() {
        let data = request.resource.data;
        return data.keys().hasAll(['mediaUrl', 'mediaType'])
               && data.mediaType in ['gif', 'image']
               && data.mediaUrl is string
               && data.mediaUrl.size() <= 2048
               && data.mediaUrl.matches('https://[^\\s/]+/[^\\s]*');
      }

      allow read: if true;
      allow create: if request.resource.data.text is string 
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.user is string
                    && request.resource.data.user.size() <= 50
                    && ((request.resource.data.text.size() > 0
                         && !request.resource.data.keys().hasAny(['mediaUrl', 'mediaType']))
                        || hasValidMedia());
      allow update: if false;
      allow delete: if true;
    }
    // Public submissions may be created, but never read, edited, or deleted publicly.
    match /contact_messages/{document} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'category', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.category in ['join', 'general', 'technical']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2500
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /open_call_applications/{document} {
      allow read, write: if true;
    }
  }
}
